!$all = {"en":{"source_001":"Source: https://github.com/chronicqazxc/transformer-architecture-uml","tr_title_001":"Decoder-only Transformer (Llama-style): Training Flow\\n","tr_act_001":"Corpus as one stream of token ids","tr_note_001":"  An EOS id is appended after every document.\n  Split into train data and validation data.\n  mini-LM: character-level tokens.","tr_act_002":"Pick the learning rate for this step","tr_note_002":"    Warmup (linear ramp up), then cosine decay down to 10% of the peak.","tr_act_003":"Sample a random batch of windows","tr_note_003":"    Each window of T tokens is cut from a random position:\n    x = ids[i : i+T]\n    y = ids[i+1 : i+T+1]    (x shifted by one token)\n\n    Toy example:\n    x = [\"cat\",  \"on\",   \"desk\"]\n    y = [\"on\",   \"desk\", \"water\"]\n    Position t must predict y[t] while seeing only x[0..t].","tr_part_001":"Forward pass (same weights and layers as generation)","tr_act_004":"Embedding","tr_act_005":"N x layer (transformer block)","tr_note_004":"      Same pre-norm layer as the generation diagram:\n      RMSNorm, attention (RoPE + causal mask), residual,\n      RMSNorm, SwiGLU FFN, residual.\n      Differences from generation:\n      * The whole window goes through at once (no KV cache).\n      * Dropout is ON (0.2 in mini-LM).\n      * The causal mask is what lets every position be trained in parallel\n        without seeing its own answer.","tr_act_006":"Final RMSNorm","tr_act_007":"LM Head W_vocab","tr_note_005":"      Applied to ALL positions (no Slicing step):\n      logits has shape [batch, T, vocab_size].","tr_part_002":"Loss (Cross-Entropy)","tr_act_008":"Loss at position 0\\n-ln p(\"on\" | \"cat\")","tr_act_009":"Loss at position 1\\n-ln p(\"desk\" | \"cat on\")","tr_act_010":"Loss at position 2\\n-ln p(\"water\" | \"cat on desk\")","tr_note_006":"      Softmax is folded into cross-entropy: each position's logits are\n      compared with the true next token y[t]. All positions run in parallel.\n      (Teacher forcing: the input is always the true text, never the model's own guess.)\n      Illustrative probabilities 0.40, 0.25, 0.05:\n      0.92, 1.39, 3.00","tr_act_011":"Mean over all batch x position losses","tr_note_007":"      (0.92 + 1.39 + 3.00) / 3 = 1.77 for this toy window.\n      Before any training the loss is about ln(vocab_size).\n      mini-LM: ln(66) = 4.19.","tr_part_003":"Learning","tr_act_012":"Zero the old gradients","tr_act_013":"Backward pass (loss.backward())","tr_note_008":"      For every weight: which direction lowers the loss?\n      (gradient of the loss with respect to that weight)","tr_act_014":"Clip the gradient norm to 1.0","tr_act_015":"AdamW step","tr_note_009":"      Nudges every weight a tiny bit against its gradient.\n      Weight decay 0.1.\n      The weights are the only thing that is learned and stored.","tr_cond_001":"Evaluation step?","tr_cond_002":"yes","tr_act_016":"Evaluate with model.eval()","tr_note_010":"      Dropout OFF, no gradients.\n      Average loss over a few batches of train data and validation data.","tr_cond_003":"Validation loss improved?","tr_cond_004":"yes","tr_act_017":"Save checkpoint (weights + config)","tr_act_018":"Generate a sample text","tr_note_011":"      Uses the generation flow with a fixed prompt and seed,\n      so differences between checkpoints come only from the weights.\n      Then model.train() turns dropout back ON.","tr_cond_005":"All steps done?","tr_cond_006":"No","tr_cond_007":"Yes","tr_act_019":"Trained weights = the model","tr_legend_001":"Color","tr_legend_002":"Meaning","tr_legend_003":"Data: corpus, batch, embedding","tr_legend_004":"Layers / transformer blocks (same as generation)","tr_legend_005":"Final RMSNorm","tr_legend_006":"LM head","tr_legend_007":"Loss","tr_legend_008":"Gradients (backward pass)","tr_legend_009":"Optimizer, learning rate","tr_legend_010":"Evaluation, checkpoint, sample","tr_legend_011":"A fork = steps that run in parallel."},"zh-tw":{"source_001":"原始碼： https://github.com/chronicqazxc/transformer-architecture-uml","tr_title_001":"Decoder-only Transformer（Llama 風格）：訓練流程\\n","tr_act_001":"語料庫：一條 token id 串流","tr_note_001":"  每份文件後面都會加上一個 EOS id。\n  切成訓練資料與驗證資料。\n  mini-LM：以字元為單位的 token。","tr_act_002":"決定這一步的學習率","tr_note_002":"    Warmup（線性上升），之後以 cosine 衰減到峰值的 10%。","tr_act_003":"隨機抽出一批文字視窗 (batch)","tr_note_003":"    每個長度 T 的視窗從隨機位置切出：\n    x = ids[i : i+T]\n    y = ids[i+1 : i+T+1]    (x 位移一個 token)\n\n    玩具範例：\n    x = [\"cat\",  \"on\",   \"desk\"]\n    y = [\"on\",   \"desk\", \"water\"]\n    位置 t 必須預測 y[t]，而且只能看到 x[0..t]。","tr_part_001":"前向傳遞（與生成使用相同的權重與層）","tr_act_004":"嵌入 (Embedding)","tr_act_005":"N 層（Transformer 區塊）","tr_note_004":"      與生成流程圖相同的 pre-norm 層：\n      RMSNorm、注意力（RoPE + 因果遮罩）、殘差、\n      RMSNorm、SwiGLU FFN、殘差。\n      與生成的差異：\n      * 整個視窗一次通過（沒有 KV 快取）。\n      * Dropout 是開啟的（mini-LM 為 0.2）。\n      * 因果遮罩讓每個位置都能平行訓練，\n        又不會看到自己的答案。","tr_act_006":"最後的 RMSNorm","tr_note_005":"      套用在「所有」位置（沒有切片步驟）：\n      logits 的形狀是 [batch, T, vocab_size]。","tr_part_002":"損失 (Cross-Entropy)","tr_act_008":"位置 0 的損失\\n-ln p(\"on\" | \"cat\")","tr_act_009":"位置 1 的損失\\n-ln p(\"desk\" | \"cat on\")","tr_act_010":"位置 2 的損失\\n-ln p(\"water\" | \"cat on desk\")","tr_note_006":"      Softmax 已包含在 cross-entropy 裡：每個位置的 logits\n      與真正的下一個 token y[t] 比較。所有位置平行計算。\n      （Teacher forcing：輸入永遠是真實文字，而不是模型自己的猜測。）\n      示範用的機率 0.40、0.25、0.05：\n      0.92, 1.39, 3.00","tr_act_011":"對所有 batch x 位置的損失取平均","tr_note_007":"      (0.92 + 1.39 + 3.00) / 3 = 1.77（這個玩具視窗）。\n      還沒訓練前，損失約為 ln(vocab_size)。\n      mini-LM：ln(66) = 4.19。","tr_part_003":"學習","tr_act_012":"清除舊的梯度","tr_act_013":"反向傳遞 (loss.backward())","tr_note_008":"      對每個權重：往哪個方向可以降低損失？\n      （損失對該權重的梯度）","tr_act_014":"把梯度範數裁剪到 1.0","tr_act_015":"AdamW 更新一步","tr_note_009":"      把每個權重朝著梯度的反方向微微推一下。\n      Weight decay 0.1。\n      權重是唯一被學習並儲存下來的東西。","tr_cond_001":"到評估步驟了嗎？","tr_cond_002":"是","tr_cond_004":"是","tr_act_016":"用 model.eval() 評估","tr_note_010":"      Dropout 關閉，不計算梯度。\n      對訓練資料與驗證資料各取幾個 batch，計算平均損失。","tr_cond_003":"驗證損失變好了嗎？","tr_act_017":"儲存 checkpoint（權重 + 設定）","tr_act_018":"生成一段範例文字","tr_note_011":"      使用生成流程，搭配固定的提示與 seed，\n      所以不同 checkpoint 之間的差異只來自權重。\n      接著 model.train() 把 dropout 重新開啟。","tr_cond_005":"所有步驟都完成了嗎？","tr_cond_006":"否","tr_cond_007":"是","tr_act_019":"訓練好的權重 = 模型","tr_legend_001":"顏色","tr_legend_002":"意義","tr_legend_003":"資料：語料庫、batch、嵌入","tr_legend_004":"層／Transformer 區塊（與生成相同）","tr_legend_005":"最後的 RMSNorm","tr_legend_006":"LM head","tr_legend_007":"損失","tr_legend_008":"梯度（反向傳遞）","tr_legend_009":"優化器、學習率","tr_legend_010":"評估、checkpoint、範例","tr_legend_011":"fork = 平行執行的步驟。"},"ja":{"source_001":"ソース: https://github.com/chronicqazxc/transformer-architecture-uml","tr_title_001":"Decoder-only Transformer (Llama 型): 学習フロー\\n","tr_act_001":"コーパス (トークン ID が一続きになったもの)","tr_note_001":"  文書ごとの最後に EOS の ID を付けます。\n  学習データと検証データに分けます。\n  mini-LM: 文字単位のトークン。","tr_act_002":"このステップの学習率を決める","tr_note_002":"    ウォームアップ (線形に上げる) のあと、cosine で最大値の 10% まで下げます。","tr_act_003":"ランダムにウィンドウのバッチを取り出す","tr_note_003":"    長さ T のウィンドウを、ランダムな位置から切り出します:\n    x = ids[i : i+T]\n    y = ids[i+1 : i+T+1]    (x を1トークンずらしたもの)\n\n    おもちゃの例:\n    x = [\"cat\",  \"on\",   \"desk\"]\n    y = [\"on\",   \"desk\", \"water\"]\n    位置 t は、x[0..t] だけを見て y[t] を予測しなければなりません。","tr_part_001":"順伝播 (生成と同じ重みと層)","tr_act_004":"エンベディング (Embedding)","tr_act_005":"N 層 (Transformer ブロック)","tr_note_004":"      生成の図と同じ pre-norm の層:\n      RMSNorm、アテンション (RoPE + 因果マスク)、残差、\n      RMSNorm、SwiGLU FFN、残差。\n      生成との違い:\n      * ウィンドウ全体を一度に通します (KV キャッシュなし)。\n      * Dropout はオンです (mini-LM では 0.2)。\n      * 因果マスクのおかげで、どの位置も自分の答えを見ずに\n        並列に学習できます。","tr_act_006":"最後の RMSNorm","tr_note_005":"      「すべての」位置に適用します (スライスのステップなし):\n      logits の形は [batch, T, vocab_size] です。","tr_part_002":"損失 (Cross-Entropy)","tr_act_008":"位置 0 の損失\\n-ln p(\"on\" | \"cat\")","tr_act_009":"位置 1 の損失\\n-ln p(\"desk\" | \"cat on\")","tr_act_010":"位置 2 の損失\\n-ln p(\"water\" | \"cat on desk\")","tr_note_006":"      Softmax は cross-entropy に含まれています。各位置の logits を\n      本当の次のトークン y[t] と比べます。すべての位置を並列に計算します。\n      (Teacher forcing: 入力は常に本物のテキストで、モデル自身の予想ではありません。)\n      例として使う確率 0.40、0.25、0.05:\n      0.92, 1.39, 3.00","tr_act_011":"バッチ x 位置すべての損失の平均","tr_note_007":"      (0.92 + 1.39 + 3.00) / 3 = 1.77 (このおもちゃのウィンドウの場合)。\n      学習前の損失は ln(vocab_size) くらいです。\n      mini-LM: ln(66) = 4.19。","tr_part_003":"学習","tr_act_012":"古い勾配をゼロにする","tr_act_013":"逆伝播 (loss.backward())","tr_note_008":"      それぞれの重みについて、どちらに動かせば損失が下がるか？\n      (その重みに対する損失の勾配)","tr_act_014":"勾配のノルムを 1.0 に切り詰める","tr_act_015":"AdamW のステップ","tr_note_009":"      すべての重みを、勾配と逆の向きにほんの少し動かします。\n      Weight decay は 0.1。\n      学習されて保存されるのは重みだけです。","tr_cond_001":"評価のステップ？","tr_cond_002":"はい","tr_cond_004":"はい","tr_act_016":"model.eval() で評価","tr_note_010":"      Dropout はオフ、勾配は計算しません。\n      学習データと検証データから数バッチ分の損失を平均します。","tr_cond_003":"検証損失は改善した？","tr_act_017":"チェックポイントを保存 (重み + 設定)","tr_act_018":"サンプル文章を生成","tr_note_011":"      固定のプロンプトと seed で生成の流れを使うので、\n      チェックポイント間の違いは重みの違いだけから生じます。\n      そのあと model.train() で dropout をオンに戻します。","tr_cond_005":"すべてのステップが完了？","tr_cond_006":"いいえ","tr_cond_007":"はい","tr_act_019":"学習済みの重み = モデル","tr_legend_001":"色","tr_legend_002":"意味","tr_legend_003":"データ: コーパス、バッチ、エンベディング","tr_legend_004":"層 / Transformer ブロック (生成と同じ)","tr_legend_005":"最後の RMSNorm","tr_legend_006":"LM head","tr_legend_007":"損失","tr_legend_008":"勾配 (逆伝播)","tr_legend_009":"オプティマイザ、学習率","tr_legend_010":"評価、チェックポイント、サンプル","tr_legend_011":"fork = 並列に実行されるステップ。"},"ko":{"source_001":"소스: https://github.com/chronicqazxc/transformer-architecture-uml","tr_title_001":"Decoder-only Transformer (Llama 스타일): 학습 흐름\\n","tr_act_001":"코퍼스: 토큰 ID가 이어진 하나의 스트림","tr_note_001":"  문서마다 끝에 EOS id를 붙입니다.\n  학습 데이터와 검증 데이터로 나눕니다.\n  mini-LM: 문자 단위 토큰.","tr_act_002":"이 스텝의 학습률 정하기","tr_note_002":"    워밍업(선형으로 올림) 후 cosine으로 최댓값의 10%까지 내립니다.","tr_act_003":"무작위로 윈도우 배치 뽑기","tr_note_003":"    길이 T인 윈도우를 무작위 위치에서 잘라 냅니다:\n    x = ids[i : i+T]\n    y = ids[i+1 : i+T+1]    (x를 한 토큰 민 것)\n\n    장난감 예시:\n    x = [\"cat\",  \"on\",   \"desk\"]\n    y = [\"on\",   \"desk\", \"water\"]\n    위치 t는 x[0..t]만 보고 y[t]를 예측해야 합니다.","tr_part_001":"순전파 (생성과 같은 가중치와 층)","tr_act_004":"임베딩 (Embedding)","tr_act_005":"N개 층(트랜스포머 블록)","tr_note_004":"      생성 다이어그램과 같은 pre-norm 층:\n      RMSNorm, 어텐션(RoPE + 인과 마스크), 잔차,\n      RMSNorm, SwiGLU FFN, 잔차.\n      생성과의 차이:\n      * 윈도우 전체가 한꺼번에 통과합니다 (KV 캐시 없음).\n      * Dropout이 켜져 있습니다 (mini-LM은 0.2).\n      * 인과 마스크 덕분에 모든 위치가 자기 정답을 보지 않고도\n        병렬로 학습됩니다.","tr_act_006":"마지막 RMSNorm","tr_note_005":"      \"모든\" 위치에 적용 (슬라이싱 단계 없음):\n      logits의 모양은 [batch, T, vocab_size]입니다.","tr_part_002":"손실(Cross-Entropy)","tr_act_008":"위치 0의 손실\\n-ln p(\"on\" | \"cat\")","tr_act_009":"위치 1의 손실\\n-ln p(\"desk\" | \"cat on\")","tr_act_010":"위치 2의 손실\\n-ln p(\"water\" | \"cat on desk\")","tr_note_006":"      Softmax는 cross-entropy 안에 포함됩니다. 각 위치의 logits를\n      실제 다음 토큰 y[t]와 비교합니다. 모든 위치를 병렬로 계산합니다.\n      (Teacher forcing: 입력은 항상 실제 텍스트이며, 모델 자신의 추측이 아닙니다.)\n      예시 확률 0.40, 0.25, 0.05:\n      0.92, 1.39, 3.00","tr_act_011":"모든 배치 x 위치 손실의 평균","tr_note_007":"      (0.92 + 1.39 + 3.00) / 3 = 1.77 (이 장난감 윈도우의 경우).\n      학습 전의 손실은 약 ln(vocab_size)입니다.\n      mini-LM: ln(66) = 4.19.","tr_part_003":"학습","tr_act_012":"이전 기울기 초기화","tr_act_013":"역전파 (loss.backward())","tr_note_008":"      모든 가중치에 대해: 어느 방향으로 움직이면 손실이 줄어드는가?\n      (그 가중치에 대한 손실의 기울기)","tr_act_014":"기울기 노름을 1.0으로 자르기","tr_act_015":"AdamW 스텝","tr_note_009":"      모든 가중치를 기울기 반대 방향으로 아주 조금 밀어 줍니다.\n      Weight decay 0.1.\n      학습되어 저장되는 것은 가중치뿐입니다.","tr_cond_001":"평가 스텝인가?","tr_cond_002":"예","tr_cond_004":"예","tr_act_016":"model.eval()로 평가","tr_note_010":"      Dropout 꺼짐, 기울기 계산 없음.\n      학습 데이터와 검증 데이터에서 몇 배치의 손실을 평균합니다.","tr_cond_003":"검증 손실이 좋아졌는가?","tr_act_017":"체크포인트 저장(가중치 + 설정)","tr_act_018":"샘플 텍스트 생성","tr_note_011":"      고정된 프롬프트와 seed로 생성 흐름을 사용하므로,\n      체크포인트 사이의 차이는 가중치에서만 나옵니다.\n      그다음 model.train()으로 dropout을 다시 켭니다.","tr_cond_005":"모든 스텝을 마쳤는가?","tr_cond_006":"아니오","tr_cond_007":"예","tr_act_019":"학습된 가중치 = 모델","tr_legend_001":"색","tr_legend_002":"의미","tr_legend_003":"데이터: 코퍼스, 배치, 임베딩","tr_legend_004":"층 / 트랜스포머 블록 (생성과 동일)","tr_legend_005":"마지막 RMSNorm","tr_legend_006":"LM head","tr_legend_007":"손실","tr_legend_008":"기울기 (역전파)","tr_legend_009":"옵티마이저, 학습률","tr_legend_010":"평가, 체크포인트, 샘플","tr_legend_011":"fork = 병렬로 실행되는 단계."}}
!$en = $all.en
!$loc = $all[$lang]
!function $t($key)
!if %json_key_exists($loc, $key)
!return $loc[$key]
!endif
!return $en[$key]
!endfunction
!theme plain
skinparam shadowing false
skinparam defaultFontSize 10
skinparam ArrowColor #555555
skinparam ActivityBorderColor #555555
skinparam ActivityDiamondBorderColor #555555
skinparam NoteBackgroundColor #FAFAFA
skinparam NoteBorderColor #B0B0B0
skinparam NoteFontSize 9
skinparam PartitionBorderColor #9E9E9E
skinparam PartitionFontSize 13
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #B0B0B0
skinparam activity {
  BackgroundColor<<data>> #D6EAF8
  BackgroundColor<<model>> #AED6F1
  BackgroundColor<<norm>> #FCF3CF
  BackgroundColor<<head>> #D7BDE2
  BackgroundColor<<loss>> #F5B7B1
  BackgroundColor<<grad>> #FADBD8
  BackgroundColor<<opt>> #D5D8DC
  BackgroundColor<<eval>> #ABEBC6
}
title $t("tr_title_001")
header $t("source_001")
footer $t("source_001")

start
:$t("tr_act_001"); <<data>>
note right
$t("tr_note_001")
end note

repeat
  :$t("tr_act_002"); <<opt>>
  note right
$t("tr_note_002")
  end note

  :$t("tr_act_003"); <<data>>
  note right
$t("tr_note_003")
  end note

  !$p_tr_part_001 = $t("tr_part_001")
  partition "$p_tr_part_001" #F4F6F7 {
    :$t("tr_act_004"); <<data>>
    :$t("tr_act_005"); <<model>>
    note right
$t("tr_note_004")
    end note
    :$t("tr_act_006"); <<norm>>
    :$t("tr_act_007"); <<head>>
    note right
$t("tr_note_005")
    end note
  }

  !$p_tr_part_002 = $t("tr_part_002")
  partition "$p_tr_part_002" #FDEDEC {
    fork
      :$t("tr_act_008"); <<loss>>
    fork again
      :$t("tr_act_009"); <<loss>>
    fork again
      :$t("tr_act_010"); <<loss>>
    end fork
    note right
$t("tr_note_006")
    end note
    :$t("tr_act_011"); <<loss>>
    note right
$t("tr_note_007")
    end note
  }

  !$p_tr_part_003 = $t("tr_part_003")
  partition "$p_tr_part_003" #FEF9E7 {
    :$t("tr_act_012"); <<opt>>
    :$t("tr_act_013"); <<grad>>
    note right
$t("tr_note_008")
    end note
