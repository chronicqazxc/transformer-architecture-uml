$t("note_028")
endnote

:$t("act_044"); <<head>>
note right
$t("note_029")
endnote

:$t("act_045"); <<head>>
:$t("act_046"); <<head>>
note right
$t("note_030")
endnote
}

!$c_004 = $t("cond_004")
!$c_005 = $t("cond_005")
!$c_006 = $t("cond_006")
