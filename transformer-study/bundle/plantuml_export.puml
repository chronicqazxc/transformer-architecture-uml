title <b>$t("title_001")</b>\n<size:10><color:#888888>$t("source_001")</color></size>
footer $t("source_001")

start
:$t("act_001"); <<inputs>>

note right
["cat", "on", "desk"]
endnote 

repeat
:$t("act_047"); <<inputs>>
note right
$t("note_033")
endnote
:$t("act_002"); <<inputs>>

note right
$t("note_001")
end note

!$c_001 = $t("cond_001")
!$c_002 = $t("cond_002")
while ($c_001) is ($c_002)

  :$t("act_003"); <<norm>>
  note right
$t("note_002")
  endnote
  note left
$t("note_032")
  endnote

  :$t("act_048"); <<attn>>


  :$t("act_026"); <<resid>>
  note right
$t("note_016")
  endnote

  :$t("act_027"); <<norm>>
  note right
$t("note_017")
  endnote

  :$t("act_049"); <<ffn>>

  :$t("act_040"); <<resid>>
  note right
$t("note_024")
  endnote

!$c_003 = $t("cond_003")
endwhile ($c_003)

:$t("act_041"); <<norm>>
note right
$t("note_025")
endnote

:$t("act_042"); <<head>>
note right
$t("note_026")
endnote

!$p_007 = $t("part_007")
