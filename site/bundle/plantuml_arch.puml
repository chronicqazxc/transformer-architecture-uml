rectangle "$t("act_061")" as nt <<inputs>>

tok -down-> emb
emb -down-> n1
n1 -down-> att
att -down-> add1
add1 -down-> n2
n2 -down-> ffn
ffn -down-> add2
add2 -down-> nf
nf -down-> sl
sl -down-> lin
lin -down-> tk
tk -down-> sm
sm -down-> tp
