skinparam ActivityDiamondBorderColor #555555
skinparam NoteBackgroundColor #FAFAFA
skinparam NoteBorderColor #B0B0B0
skinparam NoteFontSize 9
skinparam PartitionBorderColor #9E9E9E
skinparam PartitionFontSize 13
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #B0B0B0
skinparam activity {
  BackgroundColor<<inputs>> #D6EAF8
  BackgroundColor<<norm>> #FCF3CF
  BackgroundColor<<attn>> #AED6F1
  BackgroundColor<<resid>> #FAD7A0
  BackgroundColor<<ffn>> #ABEBC6
  BackgroundColor<<head>> #D7BDE2
}
skinparam TitleFontStyle plain
title <b>$t("title_001")</b>\n<size:10><color:#888888>$t("source_001")</color></size>

start
:$t("act_001"); <<inputs>>

note right
["cat", "on", "desk"]
endnote 
note left
$t("note_043")
endnote

repeat
:$t("act_047"); <<inputs>>
note right
$t("note_033")
endnote
:$t("act_002"); <<inputs>>

note right
$t("note_001")
end note
note left
$t("note_032")
end note

!$c_001 = $t("cond_001")
!$c_002 = $t("cond_002")
while ($c_001) is ($c_002)

  :$t("act_003"); <<norm>>
  note right
$t("note_002")
  endnote

  :$t("act_048"); <<attn>>


  :$t("act_026"); <<resid>>
  note right
$t("note_016")
  endnote

  :$t("act_027"); <<norm>>
  note right
$t("note_017")
  endnote

  :$t("act_049"); <<ffn>>

  :$t("act_040"); <<resid>>
  note right
$t("note_024")
  endnote

!$c_003 = $t("cond_003")
endwhile ($c_003)

:$t("act_041"); <<norm>>
note right
$t("note_025")
endnote

:$t("act_042"); <<head>>
note right
$t("note_026")
endnote

!$p_007 = $t("part_007")
partition "$p_007" #F5EEF8 {
:$t("act_043"); <<head>>
note left
$t("note_027")
endnote
note right
$t("note_042")
endnote

:$t("act_044"); <<head>>
note right
$t("note_029")
endnote

:$t("act_045"); <<head>>
note right
$t("note_058")
endnote
:$t("act_046"); <<head>>
note right
$t("note_030")
endnote
}

!$c_004 = $t("cond_004")
!$c_005 = $t("cond_005")
!$c_006 = $t("cond_006")
repeat while ($c_004) is ($c_005) not ($c_006)
stop
note right
$t("note_031")
endnote
legend right
  |= $t("legend_001") |= $t("legend_002") |
  |<#D6EAF8>   | $t("legend_003") |
  |<#FCF3CF>   | $t("legend_004") |
  |<#AED6F1>   | $t("legend_005") |
  |<#FAD7A0>   | $t("legend_006") |
  |<#ABEBC6>   | $t("legend_007") |
  |<#D7BDE2>   | $t("legend_008") |
  $t("legend_009")
endlegend
@enduml